# Copy to .env and fill in. .env is git-ignored; never commit credentials.

# ---- data source: eg4_cloud | solar_assistant | replay ----------------------
EG4MON_SOURCE=eg4_cloud

# EG4 cloud portal (same login as the EG4 Monitor app / monitor.eg4electronics.com).
# Read-only: eg4mon never calls a write endpoint. A "viewer" account is enough;
# consider creating one dedicated to this service.
EG4_BASE_URL=https://monitor.eg4electronics.com
EG4_USERNAME=
EG4_PASSWORD=
# Comma-separated inverter serial numbers (run `eg4mon discover` to find them).
# Several serials = parallel inverters on ONE battery bank (power summed, V averaged).
EG4_INVERTER_SERIALS=
# Optional GridBOSS serial (grid / load / UPS / generator power for the dashboard).
EG4_GRIDBOSS_SERIAL=
# Poll interval in seconds (minimum 10). Unchanged cloud data is never re-fed to the model.
EG4_POLL_SECONDS=30

# SolarAssistant MQTT (future source; map topics in config/topics.yaml first)
MQTT_HOST=solar-assistant.local
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Replay source (EG4MON_SOURCE=replay): play a CSV through the collector
REPLAY_CSV=
REPLAY_SPEED=0

# ---- storage / model ---------------------------------------------------------
DB_PATH=data/eg4mon.sqlite
# IANA timezone of the site: daily rollups and naive CSV timestamps use it.
SITE_TZ=America/Chicago
MODEL_PARAMS_FILE=config/model_params.yaml
PIPELINE_FILE=config/pipeline.yaml

# ---- API / dashboard ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Optional bearer token for the API (the dashboard sends it automatically).
API_TOKEN=
DASHBOARD_API_URL=http://localhost:8000
DASHBOARD_REFRESH_SECONDS=10

LOG_LEVEL=INFO
